# .gitattributes — Sange v3.
#
# Goals:
#   - LF line endings across the codebase (per .editorconfig + Simtabi CLAUDE.md).
#   - Accurate language statistics on GitHub (linguist hints for vendored / generated content).
#   - REUSE / SPDX compliance: the license-bearing files are marked.
#   - Deterministic archives: include only what should ship in `git archive` exports.

# Default — every text file uses LF in the working tree.
* text=auto eol=lf

# Python source
*.py    text eol=lf diff=python
*.pyi   text eol=lf
*.pyx   text eol=lf

# Web stack (web/)
*.php   text eol=lf diff=php
*.blade.php text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf

# Shell scripts — explicit LF, otherwise shebangs break on POSIX hosts.
*.sh    text eol=lf
*.bash  text eol=lf

# Markdown / docs
*.md    text eol=lf diff=markdown
*.rst   text eol=lf

# Config + manifests
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf

# Dockerfiles + Makefiles
Dockerfile*  text eol=lf
*.mk         text eol=lf
Makefile*    text eol=lf

# Binary files — never auto-CRLF, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.tar   binary
*.tar.gz binary
*.zip   binary
*.so    binary
*.dylib binary
*.dll   binary

# Vendored / generated content — exclude from linguist's language statistics so
# they don't dominate the language pie chart on GitHub.
docs/reference/*.md          linguist-generated=true
docs/reference/appendix-*.md linguist-generated=true
templates/MANIFEST.toml      linguist-generated=true
sange-v1/**                  linguist-vendored=true
sange-v2/**                  linguist-vendored=true

# `git archive` — anything Sange ships as a tarball excludes design metadata
# and the held v1/v2 trees.
.design/        export-ignore
sange-v1/       export-ignore
sange-v2/       export-ignore
.github/        export-ignore
.gitignore      export-ignore
.gitattributes  export-ignore
.editorconfig   export-ignore

# REUSE / SPDX — license files are plain text, preserved verbatim with LF endings.
LICENSE     text eol=lf
NOTICE      text eol=lf
AUTHORS.md  text eol=lf
